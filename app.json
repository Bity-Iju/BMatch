{
  "expo": {
    "name": "BMatch",
    "slug": "bmatch-expo",
    "owner": "bityruthys-team",
    "scheme": "bmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bmatch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/9ce5addc-8ee1-4a77-9de3-a1be3f83fe96",
      "fallbackToCacheTimeout": 0,
      "checkOnLaunch": "ALWAYS",
      "enabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9ce5addc-8ee1-4a77-9de3-a1be3f83fe96"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
